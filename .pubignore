# A root .pubignore replaces the root .gitignore for pub packaging, so it
# must repeat every exclusion from .gitignore before adding its own.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
/pubspec.lock
example/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Internal design and plan documents: tracked in the repo, not shipped in
# the published package.
doc/superpowers/

# AI coding-assistant support: the agent plugin is distributed from the git
# repository (marketplace install), never through the pub archive. Shipping
# a partial tree (visible skills without the hidden manifests) would be a
# broken plugin, so the whole tree and its tooling stay out. Hidden dirs
# (.claude-plugin/, .codex-plugin/, .agents/) are excluded by pub itself.
agent-plugin/
doc/ai/
AGENTS.md
CLAUDE.md
tool/validate_agent_plugin.dart
